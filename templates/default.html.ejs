<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
<% if (jsonLdString) { %>  <script type="application/ld+json">
<%- jsonLdString %>
  </script><% } %>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      margin: 0;
      padding: 0;
      background-color: #fff;
      color: #333;
    }

    .top-actions {
      max-width: 1000px;
      margin: 12px auto 0;
      padding: 0 20px;
      display: flex;
      justify-content: flex-end;
      gap: 10px;
    }

    .top-actions a {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 12px;
      font-size: 0.82rem;
      font-weight: 500;
      color: #555;
      background: #f5f5f5;
      border: 1px solid #e0e0e0;
      border-radius: 4px;
      text-decoration: none;
      transition: all 0.2s;
    }

    .top-actions a:hover {
      background: #e8e8e8;
      color: #111;
    }

    .container {
      max-width: 1000px;
      padding: 20px 20px 0;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      flex-wrap: nowrap;
      margin: 0 auto;
    }

    h1 {
      font-size: 2.5em;
      color: #4a4a4a;
      margin-bottom: 5px;
      margin-top: 0;
    }

    h2 {
      font-size: 1.5em;
      color: #717171;
      margin-bottom: 20px;
      font-weight: normal;
      margin-top: 0;
    }

    .main-content {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 45px;
    }

    .header,
    .contact-info {
      min-height: 216px;
    }

    .contact-info {
      text-align: right;
      font-size: 0.9em;
      color: #555;
    }

    .contact-info p {
      margin: 5px 0;
    }

    .contact-info a {
      color: #0077b5;
      text-decoration: none;
    }

    .section-title {
      font-size: 1.5em;
      margin-top: 45px;
      margin-bottom: 20px;
      color: #333;
      padding-bottom: 10px;
      border-bottom: 2px solid #ececec;
    }

    .section-title:first-child {
      margin-top: 0;
    }

    .skills,
    .languages {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .skill-badge::before {
      display: inline-block;
      content: ' #';
      opacity: 0.3;
    }

    .language-level {
      background-color: #f0f0f0;
      border-radius: 20px;
      padding: 8px 15px;
      font-size: 0.9em;
      color: #555;
    }

    .job {
      margin-bottom: 25px;
    }

    .job-header {
      font-size: 1.3em;
      margin-bottom: 5px;
      color: #333;
      line-height: 1;
      margin-top: 45px;
    }

    .section-title+.job-header {
      margin-top: 0;
    }

    .job-company,
    .job-company:visited,
    .job-company:active,
    .job-company:hover {
      font-size: 1em;
      color: #979797;
      text-decoration: none;
    }

    .job-company:active,
    .job-company:hover {
      text-decoration: underline;
    }

    .job-dates {
      font-style: italic;
      font-size: 0.75em;
      color: #777;
    }

    .job-place {
      font-style: italic;
      font-size: 0.75em;
    }

    .achievements {
      list-style-type: none;
      padding-left: 0;
      margin-top: 10px;
    }

    .achievements li {
      position: relative;
      padding-left: 20px;
      margin-bottom: 5px;
      text-wrap-style: pretty;
    }

    .achievements li::before {
      content: "•";
      position: absolute;
      left: 0;
      color: #4a90e2;
      font-size: 1.2em;
    }

    .languages .language-level {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .language-level p {
      margin: 0;
    }

    .language-level .dots {
      display: flex;
      gap: 5px;
    }

    .dots span {
      display: inline-block;
      width: 10px;
      height: 10px;
      background-color: #ccc;
      border-radius: 50%;
    }

    .dots .filled {
      background-color: #4a90e2;
    }

    .interests {
      margin-top: 20px;
    }

    @media print {
      .top-actions {
        display: none !important;
      }
    }
  </style>
</head>

<body>
  <div class="top-actions">
    <% if (pdfUrl) { %><a href="<%= pdfUrl %>" target="_blank">📥 PDF</a><% } %>
    <% if (rawMdUrl) { %><a href="<%= rawMdUrl %>" target="_blank">📄 Markdown</a><% } %>
    <% if (jsonUrl) { %><a href="<%= jsonUrl %>" target="_blank">{ } JSON</a><% } %>
    <% if (showAdmin && editUrl) { %><a href="<%= editUrl %>">✏️ Edit in Admin</a><% } %>
  </div>
  <div class="container">
    <div class="main-content">
      <div>
        <div class="header">
          <h1><%- inlineMarkdown(parsed.name) %></h1>
          <h2><%- inlineMarkdown(parsed.title) %></h2>
          <p><%- inlineMarkdown(parsed.intro) %></p>
        </div>
      </div>
      <div>
        <div class="contact-info">
          <%- contactsHtml %>
        </div>
      </div>
    </div>
    <div class="main-content">
      <div style="flex: 2;">
<%- leftColumnHtml %>      </div>

      <div style="flex: 1;">
<%- rightColumnHtml %>      </div>
    </div>
  </div>
</body>

</html>